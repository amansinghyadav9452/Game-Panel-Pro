<div class="password-overlay" id="otpOverlay">

    <div class="password-modal">

        <h3>Enter Verification Code</h3>

        <p>
            We sent a 6-digit code to your email. It expires in 5 minutes.
        </p>

        <div class="password-input">

            <input
                type="text"
                id="otpModalInput"
                maxlength="6"
                inputmode="numeric"
                placeholder="6-digit code"
            >

        </div>

        <div class="password-actions">

            <button
                type="button"
                id="otpCancel">

                Cancel

            </button>

            <button
                type="button"
                id="otpConfirm">

                Confirm

            </button>

        </div>

    </div>

</div>
