<div id="banOverlay" class="confirm-overlay ban-overlay">

    <div class="confirm-modal ban-modal">

        <div class="confirm-icon ban-icon">

            <i class="fa-solid fa-ban"></i>

        </div>

        <h2>Ban Device</h2>

        <p id="banDeviceLabel">
            Are you sure you want to ban this device?
        </p>

        <div class="ban-reason-field">

            <label for="banReasonInput">Reason (optional)</label>

            <textarea
                id="banReasonInput"
                rows="3"
                maxlength="200"
                placeholder="e.g. Using modded client, cheating, key sharing..."></textarea>

        </div>

        <div class="confirm-actions">

            <button
                id="banCancel"
                class="confirm-btn secondary">

                Cancel

            </button>

            <button
                id="banConfirm"
                class="confirm-btn danger">

                Ban Device

            </button>

        </div>

    </div>

</div>
