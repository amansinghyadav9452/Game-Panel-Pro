<div id="clearLogsOverlay" class="confirm-overlay">

    <div class="confirm-modal">

        <div class="confirm-icon">
            <i class="fa-solid fa-trash"></i>
        </div>

        <h2>Clear All Logs</h2>

        <p>Which logs do you want to delete?</p>

        <div class="clear-logs-options">

            <button
                type="button"
                id="clearUserLogsBtn"
                class="confirm-btn primary">
                <i class="fa-solid fa-users"></i>
                User Logs
            </button>

            <button
                type="button"
                id="clearAdminLogsBtn"
                class="confirm-btn primary">
                <i class="fa-solid fa-user-shield"></i>
                Admin Logs
            </button>

        </div>

        <div class="confirm-actions">

            <button
                type="button"
                id="clearLogsCancel"
                class="confirm-btn secondary">
                Cancel
            </button>

        </div>

    </div>

</div>
