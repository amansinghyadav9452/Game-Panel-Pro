<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Game Panel | Login</title>

    <link rel="preconnect" href="https://fonts.googleapis.com">

    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">

    <link rel="stylesheet"
        href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css">

    <link rel="stylesheet" href="/css/login.css">

    <link rel="stylesheet" href="/css/components/password-modal.css">

    <link rel="stylesheet" href="/css/components/otp-verify-modal.css">

    <link rel="stylesheet" href="/css/components/customer-access.css">

    <link rel="stylesheet" href="/css/interactions.css">

    <link rel="manifest" href="/manifest.json">

    <meta name="theme-color" content="#0F172A">

    <link rel="apple-touch-icon" href="/assets/icon-192.png">

    <meta name="apple-mobile-web-app-capable" content="yes">

    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">

    <meta name="apple-mobile-web-app-title" content="Game Panel">

    <script src="/js/interactions.js"></script>

    <script defer src="/js/pwa-register.js"></script>

</head>

<body>

<div class="background">

    <span class="circle c1"></span>

    <span class="circle c2"></span>

    <span class="circle c3"></span>

    <div class="particles">

        <span></span>

        <span></span>

        <span></span>

        <span></span>

        <span></span>

        <span></span>

    </div>

</div>

    <main class="login-wrapper">

        <section class="login-card">

            <div class="mouse-light"></div>

            <div class="logo">

                <div class="logo-box">

                    <i class="fa-solid fa-shield-halved"></i>

                </div>

                <h1>GAME PANEL</h1>

                <p>Enterprise Security Management</p>

                <div class="security-status" id="securityStatus">

    <span>

        <i class="fa-solid fa-circle"></i>

        MongoDB

    </span>

    <span>

        <i class="fa-solid fa-circle"></i>

        JWT

    </span>

    <span>

        <i class="fa-solid fa-circle"></i>

        Cloudflare

    </span>

</div>

            </div>

            <form id="loginForm">

                <div class="input-group">

                    <label> Admin Username</label>

                    <div class="input-box">

                        <i class="fa-solid fa-user"></i>

                        <input
                            type="text"
                            id="username"
                            placeholder="Enter username"
                            autocomplete="off"
                            required>

                    </div>

                </div>

                <div class="input-group">

                    <label> Enter Secure Password</label>

                    <div class="input-box">

                        <i class="fa-solid fa-lock"></i>

                        <input
                            type="password"
                            id="password"
                            placeholder="Enter password"
                            required>

                        <button
                            type="button"
                            id="togglePassword">

                            <i class="fa-solid fa-eye"></i>

                        </button>

                    </div>

                </div>

                <div class="login-options">

                    <a
                        href="#"
                        id="openResetPasswordBtn"
                        class="login-option-link login-option-reset">

                        <i class="fa-solid fa-key"></i>
                        Reset Password

                    </a>

                    <span class="login-option-sep" aria-hidden="true">&bull;</span>

                    <a
                        href="#"
                        id="openCustomerAccessBtn"
                        class="login-option-link login-option-customer">

                        <i class="fa-solid fa-ticket"></i>
                        Customer Access

                    </a>

<% if(settings.security.turnstileEnabled){ %>

<div
class="cf-turnstile"
data-sitekey="0x4AAAAAADz59UgKdhvFUXRc">
</div>

<% } %>

<% if (!settings?.security?.turnstileEnabled) { %>

<div class="security-note">

    <i class="fa-solid fa-flask"></i>

    Development Mode
    (Turnstile Disabled)

</div>

<% } %>

<div class="fingerprint-auth">

    <div class="fp-divider">
        <span>OR</span>
    </div>

    <button
        type="button"
        id="fingerprintLogin"
        class="fingerprint-btn">

        <div class="fp-circle">

            <i class="fas fa-fingerprint"></i>

        </div>

        <span class="fp-text">
            Touch to Authenticate
        </span>

    </button>

</div>

                <button
                    class="login-btn"
                    id="loginBtn"
                    type="submit">

                    <i class="fa-solid fa-arrow-right-to-bracket"></i>

                    Sign In

                </button>

            </form>

            <div id="message"></div>

            <div class="footer">

    <p>

<i class="fa-solid fa-shield-check"></i>

Protected by Cloudflare Turnstile • JWT • MongoDB

</p>

            </div>

        </section>

    </main>

    <div class="password-overlay" id="resetUsernameOverlay">

        <div class="password-modal">

            <h3>Reset Password</h3>

            <p>Enter your admin username. A code will be sent to your registered recovery email.</p>

            <div class="password-input">

                <input
                    type="text"
                    id="resetUsername"
                    placeholder="Admin username">

            </div>

            <div class="password-actions">

                <button type="button" id="resetUsernameCancel">Cancel</button>

                <button type="button" id="resetUsernameOk">OK</button>

            </div>

        </div>

    </div>

    <div class="password-overlay" id="resetOtpOverlay">

        <div class="password-modal">

            <h3>Enter OTP</h3>

            <p>Enter the 6-digit code sent to your email.</p>

            <div class="password-input">

                <input
                    type="text"
                    id="resetOtp"
                    maxlength="6"
                    inputmode="numeric"
                    placeholder="6-digit code">

            </div>

            <div class="password-actions">

                <button type="button" id="resetOtpCancel">Cancel</button>

                <button type="button" id="resetOtpOk">OK</button>

            </div>

        </div>

    </div>

    <div class="password-overlay" id="resetNewPasswordOverlay">

        <div class="password-modal">

            <h3>New Password</h3>

            <p>Choose a new password for your account.</p>

            <div class="password-input" style="margin-bottom:14px;">

                <input
                    type="password"
                    id="resetNewPassword"
                    placeholder="New password">

            </div>

            <div class="password-input">

                <input
                    type="password"
                    id="resetConfirmPassword"
                    placeholder="Confirm new password">

            </div>

            <div class="password-actions">

                <button type="button" id="resetNewPasswordCancel">Cancel</button>

                <button type="button" id="resetNewPasswordOk">OK</button>

            </div>

        </div>

    </div>

    <%- include("../partials/otp-verify-modal") %>

    <div class="password-overlay" id="customerAccessOverlay">

        <div class="password-modal cust-modal">

            <div class="cust-tabs">
                <button type="button" id="custTabLogin" class="cust-tab active">Login</button>
                <button type="button" id="custTabSignup" class="cust-tab">Sign Up</button>
            </div>

            <div id="custLoginPane">

                <h3>Customer Login</h3>

                <div class="password-input">
                    <input type="text" id="custLoginUsername" placeholder="Username" autocomplete="off">
                </div>

                <div class="password-input">
                    <input type="password" id="custLoginPassword" placeholder="Password">
                </div>

                <p class="cust-error" id="custLoginError"></p>

                <div class="password-actions">
                    <button type="button" id="customerAccessCancel">Cancel</button>
                    <button type="button" id="custLoginBtn">Login</button>
                </div>

            </div>

            <div id="custSignupStep1" style="display:none;">

                <h3>Enter Referral Code</h3>
                <p class="cust-hint">Ask your admin for a referral code.</p>

                <div class="password-input">
                    <input type="text" id="custReferralCode" placeholder="REF-XXXXXXXXXX" autocomplete="off" style="text-transform:uppercase;">
                </div>

                <p class="cust-error" id="custCodeError"></p>

                <div class="password-actions">
                    <button type="button" id="customerAccessCancel2">Cancel</button>
                    <button type="button" id="custVerifyCodeBtn">Verify</button>
                </div>

            </div>

            <div id="custSignupStep2" style="display:none;">

                <h3>Create Your Account</h3>
                <p class="cust-hint" id="custCodeValidUntil"></p>

                <div class="password-input">
                    <input type="text" id="custNewUsername" placeholder="Choose username" autocomplete="off">
                </div>

                <div class="password-input">
                    <input type="password" id="custNewPassword" placeholder="Choose password (6+ chars)">
                </div>

                <p class="cust-error" id="custSignupError"></p>

                <div class="password-actions">
                    <button type="button" id="custSignupBack">Back</button>
                    <button type="button" id="custSignupBtn">Create Account</button>
                </div>

            </div>

        </div>

    </div>

<script src="/vendor/simplewebauthn.js"></script>
<script src="/js/login.js"></script>
<script src="/js/otp-verify-modal.js"></script>
<script src="/js/customer-access.js"></script>
<% if (settings?.security?.turnstileEnabled) { %>

<script
src="https://challenges.cloudflare.com/turnstile/v0/api.js"
async
defer>

</script>

<% } %>

</body>

</html>