<!DOCTYPE html>
<html lang="en">

<head>

<title>Game Panel | Messenger</title>

<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="color-scheme" content="dark">

<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css">

<link rel="stylesheet" href="/css/theme.css?v=3">
<link rel="stylesheet" href="/css/toast.css">
<link rel="stylesheet" href="/css/dev-chat.css">

<style>
    *{ box-sizing:border-box; margin:0; }
    body{
        font-family:"Plus Jakarta Sans",sans-serif;
        min-height:100vh;
        background:
            radial-gradient(circle at top right, rgba(59,130,246,.12), transparent 30%),
            radial-gradient(circle at bottom left, rgba(139,92,246,.1), transparent 35%),
            linear-gradient(135deg,#08111f,#0f172a);
        display:flex;
        align-items:center;
        justify-content:center;
        padding:16px;
        color:#fff;
    }
    .messenger-portal{
        width:min(420px,100%);
        text-align:center;
        padding:40px 30px;
        background:linear-gradient(165deg, var(--surface-2), var(--surface));
        border:1px solid var(--hairline);
        border-radius:16px;
        box-shadow:
            inset 0 1px 0 rgba(255,255,255,.04),
            0 20px 50px rgba(0,0,0,.45);
    }
    .messenger-portal i{
        font-size:36px;
        color:var(--brass-bright);
        margin-bottom:16px;
    }
    .messenger-portal h1{
        font-family:var(--font-display);
        font-size:21px;
        color:#F4E9D8;
        letter-spacing:.2px;
        margin-bottom:8px;
    }
    .messenger-portal p{
        color:#9AA3AF;
        font-size:13.5px;
        margin-bottom:26px;
        line-height:1.5;
    }
    #messengerOpenBtn{
        border:none;
        padding:14px 22px;
        border-radius:10px;
        background:var(--brass-gradient);
        color:#1A1206;
        font-weight:700;
        font-size:14px;
        cursor:pointer;
        display:inline-flex;
        align-items:center;
        gap:8px;
        transition:transform .18s ease, box-shadow .18s ease;
        box-shadow:0 8px 20px rgba(201,151,74,.28);
    }
    #messengerOpenBtn:hover{
        transform:translateY(-2px);
        box-shadow:0 12px 26px rgba(201,151,74,.4);
    }
    #messengerLogoutBtn{
        margin-top:16px;
        background:none;
        border:none;
        color:#64748B;
        font-size:12.5px;
        cursor:pointer;
        display:block;
        margin-inline:auto;
    }
    #messengerLogoutBtn:hover{ color:var(--signal-red-bright); }
</style>

</head>

<body>

<%- include("../partials/toast") %>
<script defer src="/js/toast.js"></script>

<div class="messenger-portal">
    <i class="fa-solid fa-comments"></i>
    <h1 id="messengerWelcome">Messenger</h1>
    <p>Chat in real-time with the admin/developer of this panel.</p>
    <button id="messengerOpenBtn" type="button">
        <i class="fa-solid fa-message"></i> Open Chat
    </button>
    <button id="messengerLogoutBtn" type="button">Logout</button>
</div>

<%- include("../partials/dev-chat-widget") %>

<script>
(function () {

    const token = localStorage.getItem("token");

    if (!token) {
        window.location.replace("/login");
        return;
    }

    fetch("/messenger/session", {
        headers: { Authorization: `Bearer ${token}` }
    })
        .then((res) => {
            if (!res.ok) throw new Error("unauthorized");
            return res.json();
        })
        .then((data) => {

            if (!data.success) throw new Error("unauthorized");

            const welcome = document.getElementById("messengerWelcome");

            if (welcome) {
                welcome.textContent =
                    data.role === "developer"
                        ? "Welcome, Developer"
                        : `Welcome, ${data.displayName}`;
            }

        })
        .catch(() => {
            localStorage.removeItem("token");
            window.location.replace("/login");
        });

    // Toggle icon already opens the chat modal - "Open Chat" button just
    // triggers the same click so users don't have to hunt for the FAB.
    document.getElementById("messengerOpenBtn").addEventListener("click", () => {
        document.getElementById("devChatToggle")?.click();
    });

    document.getElementById("messengerLogoutBtn").addEventListener("click", () => {
        localStorage.removeItem("token");
        localStorage.removeItem("logoutAt");
        window.location.replace("/login");
    });

})();
</script>

</body>

</html>
