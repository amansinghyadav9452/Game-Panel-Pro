<!DOCTYPE html>
<html lang="en">

<head>

<title>Game Panel | Appearance</title>

<%- include("../../partials/head") %>

<link rel="stylesheet" href="/css/security-settings.css">

</head>

<body>

<div id="overlay"></div>

<%- include("../../partials/toast") %>
<%- include("../../partials/confirm-modal") %>

<%- include("../../partials/dev-chat-widget") %>

<div class="layout">

<%- include("../../partials/sidebar") %>

<main class="content">

<section class="settings-page">

<div class="settings-header">

<a href="/settings" class="back-btn">

<i class="fa-solid fa-arrow-left"></i>

</a>

<div>

<h1 class="page-heading">
Appearance
</h1>

<p class="page-subtitle">
Customize the panel interface
</p>

</div>

</div>

<div class="account-card">

<div class="setting-group">

<label>Theme</label>

<select id="darkMode">

<option value="true" <%= settings.appearance.darkMode ? "selected" : "" %>>Dark</option>

<option value="false" <%= !settings.appearance.darkMode ? "selected" : "" %>>Light</option>

</select>

</div>

<div class="setting-group">

<label>Accent Color</label>

<select id="accentColor">

<option value="blue" <%= settings.appearance.accentColor === "blue" ? "selected" : "" %>>Blue</option>

<option value="purple" <%= settings.appearance.accentColor === "purple" ? "selected" : "" %>>Purple</option>

<option value="green" <%= settings.appearance.accentColor === "green" ? "selected" : "" %>>Green</option>

<option value="orange" <%= settings.appearance.accentColor === "orange" ? "selected" : "" %>>Orange</option>

<option value="red" <%= settings.appearance.accentColor === "red" ? "selected" : "" %>>Red</option>

</select>

</div>

<div class="setting-group">

<label>Sidebar Style</label>

<select id="sidebarCollapsed">

<option value="false" <%= !settings.appearance.sidebarCollapsed ? "selected" : "" %>>Expanded</option>

<option value="true" <%= settings.appearance.sidebarCollapsed ? "selected" : "" %>>Collapsed</option>

</select>

</div>

<div class="setting-group">

<label>Animations</label>

<select id="animationsEnabled">

<option value="true" <%= settings.appearance.animationsEnabled ? "selected" : "" %>>Enabled</option>

<option value="false" <%= !settings.appearance.animationsEnabled ? "selected" : "" %>>Disabled</option>

</select>

</div>

<button id="saveAppearanceBtn" class="save-btn">

<i class="fa-solid fa-floppy-disk"></i>

Save Changes

</button>

</div>

</section>

</main>

</div>

<script src="/js/utils.js"></script>
<script src="/js/appearance-settings.js"></script>

</body>

</html>