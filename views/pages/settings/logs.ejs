<!DOCTYPE html>
<html lang="en">

<head>

<title>Game Panel | Logs</title>

<%- include("../../partials/head") %>

<link rel="stylesheet" href="/css/security-settings.css">

</head>

<body>

<div id="overlay"></div>

<%- include("../../partials/toast") %>
<%- include("../../partials/confirm-modal") %>

<div class="layout">

<%- include("../../partials/sidebar") %>

<main class="content">

<section class="settings-page">

<div class="settings-header">

<a href="/settings" class="back-btn">

<i class="fa-solid fa-arrow-left"></i>

</a>

<div>

<h1 class="page-heading">
Logs
</h1>

<p class="page-subtitle">
Manage log storage and exports
</p>

</div>

</div>

<div class="account-card">

<div class="setting-group">

<label>Log Retention</label>

<select id="retentionDays">

<option value="7" <%= settings.logs.retentionDays === 7 ? "selected" : "" %>>7 Days</option>

<option value="30" <%= settings.logs.retentionDays === 30 ? "selected" : "" %>>30 Days</option>

<option value="90" <%= settings.logs.retentionDays === 90 ? "selected" : "" %>>90 Days</option>

<option value="365" <%= settings.logs.retentionDays === 365 ? "selected" : "" %>>365 Days</option>

</select>

</div>

<div class="setting-group">

<label>Log Display Range</label>

<select id="displayRange">

<option value="live" <%= settings.logs.displayRange === "live" ? "selected" : "" %>>Live</option>

<option value="2h" <%= settings.logs.displayRange === "2h" ? "selected" : "" %>>Last 2 Hours</option>

<option value="24h" <%= settings.logs.displayRange === "24h" ? "selected" : "" %>>Last 24 Hours</option>

<option value="7d" <%= settings.logs.displayRange === "7d" ? "selected" : "" %>>Last 7 Days</option>

<option value="1m" <%= settings.logs.displayRange === "1m" ? "selected" : "" %>>Last 1 Month</option>

</select>

<p class="field-hint">Controls how many days of user logs are shown on the Logs page.</p>

</div>

<div class="setting-group">

<label>Export Logs</label>

<button id="exportLogsBtn" class="action-btn">

<i class="fa-solid fa-file-export"></i>

Export Logs

</button>

</div>

<div class="setting-group">

<label>Download Error Logs</label>

<button id="downloadErrorsBtn" class="action-btn">

<i class="fa-solid fa-bug"></i>

Download Errors

</button>

</div>

<div class="setting-group">

<label>Clear All Logs</label>

<button class="danger-btn">

<i class="fa-solid fa-trash"></i>

Delete Logs

</button>

</div>

<button id="saveLogsBtn" class="save-btn">

<i class="fa-solid fa-floppy-disk"></i>

Save Changes

</button>

</div>

</section>

</main>

</div>

<script src="/js/utils.js"></script>
<script src="/js/logs-settings.js"></script>

</body>

</html>