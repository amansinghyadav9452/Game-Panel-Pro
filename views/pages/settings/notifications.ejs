<!DOCTYPE html>
<html lang="en">

<head>

<title>Game Panel | Notifications</title>

<%- include("../../partials/head") %>

<link rel="stylesheet" href="/css/security-settings.css">

</head>

<body>

<div id="overlay"></div>

<%- include("../../partials/toast") %>
<%- include("../../partials/confirm-modal") %>

<div class="layout">

<%- include("../../partials/sidebar") %>

<main class="content">

<section class="settings-page">

<div class="settings-header">

<a href="/settings" class="back-btn">

<i class="fa-solid fa-arrow-left"></i>

</a>

<div>

<h1 class="page-heading">
Notifications
</h1>

<p class="page-subtitle">
Configure notification preferences
</p>

</div>

</div>

<div class="account-card">

<div class="setting-group">

<label>Telegram Alerts</label>

<select id="telegram">

<option value="true" <%= settings.notifications.telegram ? "selected" : "" %>>Enabled</option>

<option value="false" <%= !settings.notifications.telegram ? "selected" : "" %>>Disabled</option>

</select>

</div>

<div class="setting-group">

<label>Discord Alerts</label>

<select id="discord">

<option value="true" <%= settings.notifications.discord ? "selected" : "" %>>Enabled</option>

<option value="false" <%= !settings.notifications.discord ? "selected" : "" %>>Disabled</option>

</select>

</div>

<div class="setting-group">

<label>Discord Webhook</label>

<input
id="discordWebhookUrl"
type="text"
value="<%= settings.notifications.discordWebhookUrl %>"
placeholder="https://discord.com/api/webhooks/...">

</div>

<div class="setting-group">

<label>Email Notifications</label>

<select id="email">

<option value="true" <%= settings.notifications.email ? "selected" : "" %>>Enabled</option>

<option value="false" <%= !settings.notifications.email ? "selected" : "" %>>Disabled</option>

</select>

</div>

<div class="setting-group">

<label>Critical Alerts Only</label>

<select id="criticalOnly">

<option value="true" <%= settings.notifications.criticalOnly ? "selected" : "" %>>Enabled</option>

<option value="false" <%= !settings.notifications.criticalOnly ? "selected" : "" %>>Disabled</option>

</select>

</div>

<button id="saveNotificationsBtn" class="save-btn">

<i class="fa-solid fa-floppy-disk"></i>

Save Changes

</button>

</div>

</section>

</main>

</div>

<script src="/js/utils.js"></script>
<script src="/js/notifications-settings.js"></script>

</body>
</html>