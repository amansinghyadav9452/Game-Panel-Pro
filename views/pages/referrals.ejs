<!DOCTYPE html>
<html lang="en">
<head>

<title>Game Panel | Referrals</title>
<%- include("../partials/head") %>
<link rel="stylesheet" href="/css/customer.css">

</head>

<body>

<div id="overlay"></div>

<%- include("../partials/toast") %>
<%- include("../partials/confirm-modal") %>

<%- include("../partials/dev-chat-widget") %>

<div class="layout">

<%- include("../partials/sidebar") %>

    <main class="content">

        <%- include("../partials/topbar") %>

        <section class="overview-section">

            <div class="cust-toolbar">

                <h2 style="margin:0;flex:1;color:#fff;font-size:18px;">
                    <i class="fa-solid fa-ticket"></i> Referral Codes
                </h2>

                <input type="number" id="refExpiryDays" placeholder="Valid for (days)" min="1" value="30" style="width:170px;background:#1F2937;color:#fff;border:1px solid rgba(255,255,255,.1);border-radius:10px;padding:9px 12px;font-size:13px;">

                <button id="createReferralBtn" class="cust-primary-btn" type="button">
                    <i class="fa-solid fa-plus"></i> Generate Code
                </button>

            </div>

            <div id="referralsList" class="cust-list"></div>

            <h2 style="margin:28px 0 14px;color:#fff;font-size:18px;">
                <i class="fa-solid fa-users"></i> Customers
            </h2>

            <div id="customersList" class="cust-list"></div>

        </section>

    </main>

</div>

<script src="/js/api.js"></script>
<script src="/js/utils.js"></script>
<script src="/js/referrals.js"></script>

</body>
</html>
