<!DOCTYPE html>
<html lang="en">
<head>
<title>Game Panel | Referrals</title>
<%- include("../partials/head") %>
<link rel="stylesheet" href="/css/customer.css">
</head>
<body class="referrals-page">
<div id="overlay"></div>
<%- include("../partials/toast") %>
<%- include("../partials/confirm-modal") %>
<%- include("../partials/dev-chat-widget") %>
<div class="layout">
    <%- include("../partials/sidebar") %>
    <main class="content">
        <%- include("../partials/topbar") %>
        <section class="overview-section referral-console">
            <div class="cust-toolbar referral-toolbar">
                <h2><i class="fa-solid fa-ticket"></i> Referral Codes</h2>
                <input type="number" id="refExpiryDays" placeholder="Valid for (days)" min="1" max="3650" value="30" aria-label="Referral validity in days">
                <button id="createReferralBtn" class="cust-primary-btn" type="button">
                    <i class="fa-solid fa-plus"></i> Generate Code
                </button>
            </div>
            <div id="referralsList" class="cust-list" aria-live="polite"></div>
            <h2 class="referral-section-title">
                <i class="fa-solid fa-users"></i> Customers
            </h2>
            <div id="customersList" class="cust-list" aria-live="polite"></div>
        </section>
    </main>
</div>
<script src="/js/api.js"></script>
<script src="/js/utils.js"></script>
<script src="/js/referrals.js"></script>
</body>
</html>
